APP_NAME=Lavish
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Addis_Ababa

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lavish
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="care@lavish.et"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ------------------------------------------------------------------ Lavish
# Web portal origin(s) allowed to call the API from the browser (comma separated)
LAVISH_CORS_ORIGINS=http://localhost:5173
LAVISH_DELIVERY_FEE=150
LAVISH_ACADEMY_PHONE=+251911001122
LAVISH_APP_URL=https://lavish.et/app
# Online consultations: video rooms are created under this base URL
LAVISH_VIDEO_BASE_URL=https://meet.jit.si
# Token lifetimes
LAVISH_WEB_TOKEN_HOURS=12
LAVISH_MOBILE_TOKEN_DAYS=90
# With SMS_DRIVER=log (not production) every OTP code is this value
LAVISH_DEV_OTP=123456

# SMS: log (writes to storage/logs/laravel.log) | afromessage
SMS_DRIVER=log
AFROMESSAGE_TOKEN=
AFROMESSAGE_IDENTIFIER_ID=
AFROMESSAGE_SENDER=Lavish

# Push notifications: log (FCM driver to be added with the Firebase project)
PUSH_DRIVER=log

# Chapa payments: fake (local test checkout, no money) | live (use Chapa TEST keys first)
CHAPA_MODE=fake
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
CHAPA_RETURN_URL=https://lavish.et/payment-complete

# Payments: Chapa is off; clients pay by Telebirr/CBE/bank/cash and upload a receipt
ONLINE_PAYMENTS_ENABLED=false
PAY_TELEBIRR=
PAY_CBE=
PAY_BANK=
